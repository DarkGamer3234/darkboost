{
  "schemaVersion": 1,
  "id": "darkboost",
  "version": "${version}",
  "name": "PackSpoofer",
  "description": "Client-side mod that can report server resource packs as applied without downloading or loading them.",
  "authors": ["DarkGamer3234"],
  "contact": {
    "sources": "https://github.com/DarkGamer3234/darkboost"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.darkboost.DarkBoostClient"
    ]
  },
  "mixins": [
    "darkboost.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.160.5"
  }
}
